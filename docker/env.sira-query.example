# sira-query runtime — copy to .env.sira-query (gitignored). Injected into the
# container as-is; NORA_SIRA_DB_ROOT is fixed to /data/db by compose and wins.

# ---- expansion / synthesis LLM ------------------------------------------------
# NOTE: the service appends /v1/chat/completions itself -> URL WITHOUT /v1.
NORA_LLM_SHIM_URL=http://host.docker.internal:PORT
# Model name sent in requests. Unset -> the service sends the placeholder
# "sira-shim", which only works against the local shim (it ignores the field).
# Routing directly to a real OpenAI-compat endpoint REQUIRES this, or query
# enrichment fails with model_not_found. List names: curl <endpoint>/v1/models
# (Yes, the var really is NORA_LLM_MODEL here — the service shares the name.)
#NORA_LLM_MODEL=
#NORA_LLM_SHIM_API_KEY=          # falls back to NORA_LLM_API_KEY

# ---- rerank backend (D-116 pluggable; D-117 bulk resilience) -------------------
# URL also WITHOUT /v1 here (service-side convention).
NORA_SIRA_RERANK_ENABLED=
NORA_SIRA_RERANK_LLM_URL=http://host.docker.internal:PORT
NORA_SIRA_RERANK_LLM_MODEL=
#NORA_SIRA_RERANK_LLM_API_KEY=
#NORA_SIRA_RERANK_BACKEND=          # chat | tei | openai-dedicated
#NORA_RERANK_BATCH_SIZE=            # (renamed from NORA_SIRA_RERANK_BATCH_SIZE)
#NORA_SIRA_RERANK_BULK_BATCH_SIZE=
#NORA_SIRA_RERANK_BATCH_MAX_TOKENS=
#NORA_SIRA_RERANK_MAX_TOKENS=
#NORA_SIRA_RERANK_TOP_N=

# ---- retrieval / fusion tuning -------------------------------------------------
#NORA_SIRA_TOP_K=
#NORA_SIRA_SCALE_TOPK_BY_CELLS=     # per-cell top_k (D-121)
#NORA_SIRA_FUSION_BALANCED=         # balanced cross-cell fusion (D-118)
#NORA_SIRA_FANOUT_ENABLED=
#NORA_SIRA_FANOUT_PER_HIT=
#NORA_SIRA_MAX_DF_RATIO=
#NORA_SIRA_EXPANSION_WEIGHT=
#NORA_SIRA_QUERY_ENRICH_TEMPERATURE=

# ---- run pinning / legacy ------------------------------------------------------
#NORA_SIRA_DOC_ENRICH_RUN=
#NORA_SIRA_QUERY_ENRICH_RUN=
#NORA_SIRA_RERANK_RUN=
#NORA_SIRA_USE_LATEST_RUNS=
#NORA_SIRA_DATASET=                 # legacy single-dataset mode only
