# BUILD + STACK WIRING — copy to .env (compose reads it for interpolation).
# Runtime knobs for each container live in the per-service files:
#   env.nora-web.example      -> .env.nora-web
#   env.sira-query.example    -> .env.sira-query
#   env.nora-pipeline.example -> .env.nora-pipeline
#   env.sira-batch.example    -> .env.sira-batch
# NEVER commit the filled-in files — real endpoints/hosts/keys live only there
# (D-062 boundary). 127.0.0.1:PORT values are placeholders.

# ---- stack identity (vary per A/B stack) -----------------------------------
STACK_NAME=nora
NORA_WEB_PORT=8000
SIRA_QUERY_PORT=8040

# ---- images + build-time knobs ----------------------------------------------
IMAGE_PREFIX=local
IMAGE_TAG=dev
SIRA_REF=62ec59cfb0d76f28ceb3c3d80023ac58a98e4b7a   # pinned upstream commit (patches verified)
# Work PC: set TORCH_INDEX_URL=https://pypi.org/simple (CPU index is
# allowlist-blocked). Proxies are picked up from your shell if exported,
# or set them here — they become build args AND are recorded in image
# metadata, so never use a credentialed proxy URL.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# OFFLINE=1: hosts with no container egress at all, or deterministic
# fully-vendored builds — consumes docker/vendor/ (run ./prep-offline.sh on
# the host first). 0 = normal online build (works behind PQ-hello-resetting
# DPI thanks to the classical-TLS config baked into the images).
OFFLINE=0
#HTTP_PROXY=
#HTTPS_PROXY=
#NO_PROXY=localhost,127.0.0.1

# Ingest jobs (nora-pipeline / sira-batch) run as this user/group id so
# build artifacts on the mounts aren't root-owned on the host. Set to your
# user: `id -u` / `id -g` (usually 1000/1000). Unset = root (the default).
#JOB_UID=1000
#JOB_GID=1000

# ---- host data paths (volumes) ----------------------------------------------
# On snap-docker hosts these must be VISIBLE $HOME paths: snap's confinement
# blocks /tmp entirely and hidden top-level dirs like ~/.cache (both hit in
# practice). e.g. /home/you/nora-data/...
REQUIREMENTS_DIR=/abs/path/to/requirements # canonical source docs: <MNO>/<MMMYYYY>/ (shared by all builds)
NORA_ENV_DIR=/abs/path/to/nora-build       # a build dir: out/, state/, corrections/, reports/
SIRA_DB_ROOT=/abs/path/to/sira_db_root     # <MNO>__<MMMYYYY>/ cells
WEB_STATE_DIR=/abs/path/to/web-state       # per stack: jobs/metrics/config DBs
FEEDBACK_DIR=/abs/path/to/feedback         # POOLED across stacks (attributable A/B)
MODELS_DIR=/abs/path/to/models             # docling/ artifacts, HF caches

# ---- per-service runtime env files (defaults shown; vary per A/B stack) -----
#WEB_ENV_FILE=.env.nora-web
#SIRA_QUERY_ENV_FILE=.env.sira-query
#PIPELINE_ENV_FILE=.env.nora-pipeline
#SIRA_BATCH_ENV_FILE=.env.sira-batch
# Optional credentials overlay, loaded AFTER each service env file (wins on
# overlap) into ALL services. Keep API keys/tokens here and NEVER commit it —
# then the per-service env files above are safe to share/commit.
#SECRETS_ENV_FILE=.env.secrets

# ---- distribution (push.sh / pull.sh) ----------------------------------------
# Commented on purpose: push/pull source .env AFTER the shell environment, so
# an empty `GHHOST=` here would clobber exported values. Fill in OR export.
#GHHOST=                      # internal GitHub hostname (never commit filled)
#GHORG=                       # team org
#GHREPO=nora
#GHTOKEN=                     # PAT with repo scope
