# Copy to .env (or .env.stack-a / .env.stack-b for A/B stacks) and fill in.
# NEVER commit the filled-in file — real endpoints/hosts/keys live only here
# (D-062 boundary). 127.0.0.1:PORT values below are placeholders.

# ---- stack identity (vary per A/B stack) -----------------------------------
STACK_NAME=nora
NORA_WEB_PORT=8000
SIRA_QUERY_PORT=8040

# ---- images ----------------------------------------------------------------
IMAGE_PREFIX=local            # or <internal-github-org>/nora via pull.sh
IMAGE_TAG=dev
SIRA_REF=62ec59cfb0d76f28ceb3c3d80023ac58a98e4b7a   # pinned upstream commit (patches verified)
# Build-time knobs (compose maps these into build.args — .env drives builds too).
# Work PC: set TORCH_INDEX_URL=https://pypi.org/simple (CPU index is blocked);
# HTTP(S)_PROXY are picked up from your shell if exported, or set them here.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# ---- host data paths (volumes) ----------------------------------------------
# On snap-docker hosts these must be VISIBLE $HOME paths: snap's confinement
# blocks /tmp entirely and hidden top-level dirs like ~/.cache (both hit in
# practice). e.g. /home/you/nora-data/...
NORA_ENV_DIR=/abs/path/to/env_dir          # input/, out/, state/, corrections/, reports/
SIRA_DB_ROOT=/abs/path/to/sira_db_root     # <MNO>__<MMMYYYY>/ cells
WEB_STATE_DIR=/abs/path/to/web-state       # per stack: jobs/metrics/config DBs
FEEDBACK_DIR=/abs/path/to/feedback         # POOLED across stacks (attributable A/B)
MODELS_DIR=/abs/path/to/models             # docling/ artifacts, HF caches

# ---- LLM endpoints (all external; vary per A/B stack) ------------------------
# NORA web / pipeline lanes
NORA_LLM_PROVIDER=
NORA_LLM_BASE_URL=http://127.0.0.1:11434
NORA_LLM_MODEL=
NORA_LLM_API_KEY=
NORA_EMBEDDING_PROVIDER=
NORA_EMBEDDING_MODEL=

# SIRA query service (expansion/synthesis + rerank). NOTE: the service appends
# /v1/chat/completions itself -> URL WITHOUT /v1.
NORA_LLM_SHIM_URL=http://host.docker.internal:PORT
NORA_LLM_SHIM_MODEL=
NORA_SIRA_RERANK_LLM_URL=http://host.docker.internal:PORT
NORA_SIRA_RERANK_LLM_MODEL=
NORA_SIRA_RERANK_ENABLED=
NORA_RERANK_BATCH_SIZE=

# SIRA batch enrichment (per-stage routing patch). NOTE: the batch pipeline
# expects the URL WITH /v1 (convention differs from the service — see
# sandbox/README.md §4 caution).
NORA_SIRA_ENRICH_LLM_URL=http://host.docker.internal:PORT/v1
NORA_SIRA_ENRICH_LLM_MODEL=
NORA_SIRA_BATCH_RERANK_LLM_URL=http://host.docker.internal:PORT/v1
NORA_SIRA_RERANK_LLM_MODEL=

# ---- distribution (push.sh / pull.sh) ----------------------------------------
GHHOST=                       # internal GitHub hostname (never commit filled)
GHORG=                        # team org
GHREPO=nora
GHTOKEN=                      # PAT with repo scope
