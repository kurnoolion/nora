# sira-batch runtime — copy to .env.sira-batch (gitignored). Injected into the
# container as-is (per-stage routing patch env vars).

# NOTE: the batch pipeline expects these WITH /v1 (convention differs from the
# query service — see sandbox/README.md §4 caution).
NORA_SIRA_ENRICH_LLM_URL=http://host.docker.internal:PORT/v1
NORA_SIRA_ENRICH_LLM_MODEL=

# Batch RERANK routing — only used if you run SIRA's batch rerank/eval stages
# (e.g. an 18-Q benchmark run of the full run_pipeline). The standard ingest
# flow (--stages prepare,bm25,enrich_corpus) never runs rerank: query-time
# rerank lives in the sira-query SERVICE (its toggle/routing are in
# env.sira-query.example). Leave empty otherwise.
#NORA_SIRA_RERANK_LLM_URL=http://host.docker.internal:PORT/v1
#NORA_SIRA_RERANK_LLM_MODEL=

# Batched doc-enrichment (strand sira-enrichment-pe). Activates
# automatically when the resolved doc prompt is in the batched shape
# ({requirements} placeholder); legacy single-req prompts keep the old
# per-req path. All optional — defaults in sandbox/enrich_batching.py.
#NORA_SIRA_DOC_PROMPT_DIR=/app/customizations/prompts
                                    # dir holding doc_requirement_<MNO>_v*.txt
                                    # (per-cell prompt resolution by the cell's MNO;
                                    # baked into the image from customizations/prompts/
                                    # at build — rebuild after a prompt update)
#NORA_SIRA_TAXONOMY_DIR=            # <env_dir>/out/taxonomy (per-plan *_features.json)
#NORA_SIRA_BATCH_PROMPT_CAP_TOKENS= # default 50000
#NORA_SIRA_BATCH_CONTEXT_TOKENS=    # default 64000 (LLM context)
#NORA_SIRA_BATCH_RESP_TOKENS_PER_REQ= # default 90 (measured p95 86). Also caps
                                    # reqs/batch: (context−prompt_cap)/this. Raise it
                                    # (e.g. 400 → ≤35 reqs) when big-plan batches
                                    # truncate at the endpoint's real output ceiling
                                    # (symptom: parse_error batches ≫ avg reqs,
                                    # "no JSON object in response")
#NORA_SIRA_BATCH_MAX_REQS=          # default 0 (= cap derived from response
                                    # budget). >=1 hard-caps reqs/batch below
                                    # that; 1 = single-req mode — same batched
                                    # prompt (taxonomy block included) and
                                    # retry/trace machinery, one LLM call per
                                    # req. Never loosens the derived cap.
#NORA_SIRA_BATCH_CHARS_PER_TOKEN=   # default 3.5
#NORA_SIRA_BATCH_RETRIES=           # default 2 (re-queue rounds)
#NORA_SIRA_BATCH_CONCURRENCY=       # default 2 (concurrent batch calls)
#NORA_SIRA_BATCH_DEBUG_RAW=         # 1 = on "unknown req_ids" warnings, also log
                                    # the response's first 2 lines. Raw text carries
                                    # corpus content — keep such logs local, never
                                    # in shared reports
#NORA_SIRA_BATCH_REASONING_SENTINEL= # 1 = append the ===FINAL_ANSWER=== instruction
                                    # to every batch prompt and parse ONLY what
                                    # follows the marker. For endpoints whose
                                    # UNTAGGED thinking leaks into content (no
                                    # <think> tags; draft JSON defeats brace-scans).
                                    # Same pattern as NORA_LLM_REASONING_SENTINEL
