# nora-store runtime — copy to .env.nora-store (gitignored). Injected into the
# container as-is; NORA_STORE_ROOT is fixed to /data/db by compose and wins.

# ---- expansion / synthesis LLM ------------------------------------------------
# NOTE: the service appends /v1/chat/completions itself -> URL WITHOUT /v1.
NORA_LLM_SHIM_URL=http://host.docker.internal:PORT
# Model name sent in requests. Unset -> the service sends the placeholder
# "sira-shim", which only works against the local shim (it ignores the field).
# Routing directly to a real OpenAI-compat endpoint REQUIRES this, or query
# enrichment fails with model_not_found. List names: curl <endpoint>/v1/models
# (Yes, the var really is NORA_LLM_MODEL here — the service shares the name.)
#NORA_LLM_MODEL=
#NORA_LLM_SHIM_API_KEY=          # falls back to NORA_LLM_API_KEY

# ---- rerank backend (D-116 pluggable; D-117 bulk resilience) -------------------
# URL also WITHOUT /v1 here (service-side convention).
NORA_SIRA_RERANK_ENABLED=
NORA_SIRA_RERANK_LLM_URL=http://host.docker.internal:PORT
NORA_SIRA_RERANK_LLM_MODEL=
#NORA_SIRA_RERANK_LLM_API_KEY=
#NORA_SIRA_RERANK_BACKEND=          # chat | tei | openai-dedicated
#NORA_RERANK_BATCH_SIZE=            # (renamed from NORA_SIRA_RERANK_BATCH_SIZE)
#NORA_SIRA_RERANK_BULK_BATCH_SIZE=
#NORA_SIRA_RERANK_BATCH_MAX_TOKENS=
#NORA_SIRA_RERANK_MAX_TOKENS=
#NORA_SIRA_RERANK_TOP_N=

# ---- permanent-refusal fallback ------------------------------------------------
# Some endpoints deterministically refuse certain inputs (fixed notice
# instead of an answer). When a marker AND a fallback URL are set, any
# _llm_call whose response starts with a marker (and carries no JSON) is
# re-sent once to the fallback model — covers query enrichment AND chat
# rerank. URL WITHOUT /v1 (service convention). Marker values are
# deployment-specific — set them HERE only, never in committed files.
# Multiple markers: separate with ||. /healthz shows configured/used counts.
#NORA_SIRA_QUERY_FALLBACK_LLM_URL=http://host.docker.internal:PORT
#NORA_SIRA_QUERY_FALLBACK_LLM_MODEL=
#NORA_SIRA_QUERY_FALLBACK_LLM_API_KEY=
# Fallback reasoning level (a model that thinks by default can return empty
# content); unset -> NORA_LLM_FALLBACK_REASONING(_CONTROL), else the default.
#NORA_SIRA_QUERY_FALLBACK_LLM_REASONING=none
#NORA_SIRA_QUERY_FALLBACK_LLM_REASONING_CONTROL=chat_template_kwargs
#NORA_LLM_REFUSAL_MARKERS=

# ---- query analyzer (experimental; strand jev-experimentation) ----------------
# Leave unset on a served stack. Unset = rules, today's classifier. This
# service reads only the MNOs and releases from the analyzer; the decision
# model answers query_type / doc_type_scope, which nothing here reads, so a
# non-rules value adds one decision-model call per query for no effect
# (D-DRAFT-27). /healthz key `query_analyzer` shows the arm actually built.
# A bad value warns and falls back to rules; it never stops the service.
#NORA_QUERY_ANALYZER=               # rules (default) | llm | decision |
                                    # confidence-routed (llm degrades to rules
                                    # today: no LLM provider is wired here)
# Decision provider, read only by decision / confidence-routed. No default:
# unset = warning + rules. `mock` is an offline stub for smoke tests only.
#NORA_DECISION_PROVIDER=            # systemone | mock
#NORA_DECISION_BASE_URL=http://host.docker.internal:PORT/v1   # in-corp only
#NORA_DECISION_MODEL=               # unset = the server's default model
#NORA_DECISION_TIMEOUT=             # seconds, default 30
#NORA_DECISION_API_KEY=             # unset = no Authorization header
#NORA_DECISION_CONFIDENCE_FLOOR=    # confidence-routed only, default 0.50

# ---- retrieval / fusion tuning -------------------------------------------------
#NORA_SIRA_TOP_K=
#NORA_SIRA_SCALE_TOPK_BY_CELLS=     # per-cell top_k (D-121)
#NORA_SIRA_FUSION_BALANCED=         # balanced cross-cell fusion (D-118)
#NORA_SIRA_FANOUT_ENABLED=
#NORA_SIRA_FANOUT_PER_HIT=
#NORA_SIRA_MAX_DF_RATIO=
#NORA_SIRA_EXPANSION_WEIGHT=
#NORA_SIRA_QUERY_ENRICH_TEMPERATURE=

# ---- run pinning / legacy ------------------------------------------------------
#NORA_SIRA_DOC_ENRICH_RUN=
#NORA_SIRA_QUERY_ENRICH_RUN=
#NORA_SIRA_RERANK_RUN=
#NORA_SIRA_USE_LATEST_RUNS=
#NORA_STORE_DATASET=                 # legacy single-dataset mode only

# ---- review UI display ---------------------------------------------------------
#NORA_SIRA_ENRICH_MODEL_NAME=       # LLM name shown in the enrichments header;
                                    # overrides the run config.json-derived name
                                    # (config can differ from the actually-serving model)

# ---- cell-db serving mode (corp-db-layer phase 2) ------------------------------
# Default (unset) = flat files, today's path, byte-untouched.
#NORA_STORE_INDEX=                   # flat (default) | cell-db — with cell-db,
                                    # the db mount holds cell-<mno>-<release>.db
                                    # files from sandbox/cell_db_convert.py
#NORA_STORE_ENGINE=                  # cell-db mode only: bm25x (default; loads
                                    # the enriched index blobs — byte-exact
                                    # parity with the flat stack) | fts5 (MATCH
                                    # scoring inside SQLite; A/B candidate)
#NORA_SIRA_PROMPTS_FROM=            # cell-db mode: a flat cell dir to load the
                                    # query-enrich/rerank prompts from, so both
                                    # A/B stacks serve byte-identical prompts;
                                    # unset = the clone's canonical prompts

# ---- Overlay store (enrichment-review edits; strand corp-db-layer S3) ---------
# Unset = read the JSON edits under NORA_STORE_CORRECTIONS_ROOT (fixed by
# compose). Set = read the Overlay SQLite file instead (it wins). Must name
# the SAME file as NORA_OVERLAY_DB in .env.nora-web: nora-web is the only
# writer; this service opens it read-only (WAL lets it read while the web
# writes; same host only).
#NORA_OVERLAY_DB=/data/corrections/overlay.db

# ---- hosted stores (strand corp-db-layer S6) ----------------------------------
# This service hosts /stores/{cells,trees,history,overlay}/v1 for nora-web's
# store clients. It is the Overlay AUTHORITY: the corrections mount is
# read-write and nora-web's review edits arrive over HTTP (no shared mutable
# file between containers). NORA_ENV_DIR (fixed by compose) feeds the Trees
# store from the parse trees; the pre-built SQLite stores are opt-in
# (uncomment the mounts in docker-compose.yml, then the paths here).
#NORA_TREES_ROOT=/data/trees         # trees-<mno>-<release>.db (trees_build)
#NORA_HISTORY_ROOT=/data/history     # history-<mno>.db (history_build)

# ---- publish registry (strand corp-db-layer 4b) --------------------------------
# Compose sets NORA_STORE_REGISTRY to /data/serve/registry.db when the wiring
# .env sets SERVE_REGISTRY_ROOT. The cell DBs, Trees and History then come
# from the registry's ACTIVE release set (core.src.stores.publish flips it);
# NORA_STORE_ROOT / NORA_ENV_DIR are unused for those stores, registry mode
# implies cell-db, and `publish flip --store-url` calls POST /registry/reload
# then checks /healthz (registry_label, registry_versions). Read-only here.
# A staged set under gate is served by naming it (compose: SERVE_RELEASE_SET):
#NORA_STORE_RELEASE_SET=
# Peer read: in an A/B pair that shares one correction set, name the OTHER
# stack's nora-store as the Overlay authority. This service then reads the
# overlay from it (composition and its own /stores/overlay routes) and
# answers 409 to writes; nora-web's NORA_OVERLAY_URL must name the
# authority too. Unset = this service is the authority.
#NORA_OVERLAY_URL=http://host.docker.internal:PORT
