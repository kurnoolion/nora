# nora-pipeline runtime — copy to .env.nora-pipeline (gitignored). Injected into
# the container as-is; ENV_DIR, DOCLING_ARTIFACTS, HF_HUB_OFFLINE are fixed to
# container paths by compose and win.

# ---- LLM + embeddings (taxonomy/eval stages, vectorstore build) ----------------
# NOTE /v1: with NORA_LLM_PROVIDER=openai-compatible, the provider appends
# /chat/completions only -> NORA_LLM_BASE_URL must INCLUDE /v1 (e.g. Ollama's
# OpenAI-compat surface is http://host.docker.internal:11434/v1). With
# NORA_LLM_PROVIDER=ollama the URL is Ollama-native (no /v1 anywhere).
NORA_LLM_PROVIDER=
NORA_LLM_BASE_URL=http://host.docker.internal:11434
NORA_LLM_MODEL=
NORA_LLM_API_KEY=
NORA_EMBEDDING_PROVIDER=
NORA_EMBEDDING_MODEL=
#NORA_LLM_TIMEOUT=

# ---- extraction knobs -----------------------------------------------------------
#DOCLING_OCR=                       # =1 forces OCR (scanned pages); off for born-digital

# ---- runtime network (proxied hosts) --------------------------------------------
# The standards stage downloads specs at RUN time; containers do not inherit
# the host proxy. Set these here if your host needs the corp proxy:
#HTTP_PROXY=
#HTTPS_PROXY=
#NO_PROXY=localhost,127.0.0.1,host.docker.internal
