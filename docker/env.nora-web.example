# nora-web runtime — copy to .env.nora-web (gitignored). Injected into the
# container as-is; compose `environment:` (container paths, service URLs)
# always wins over this file.

# ---- web access mode ---------------------------------------------------------
# Team mode restricts the app to the /test eval surface; admins unlock full
# access via /admin-unlock?token=<NORA_WEB_ADMIN_TOKEN> (HttpOnly cookie).
# Unset/0 = full access for everyone (single-user default).
NORA_WEB_TEAM_MODE=1
NORA_WEB_ADMIN_TOKEN=

# ---- LLM + embeddings (NORA-native lanes) ------------------------------------
# NOTE /v1: with NORA_LLM_PROVIDER=openai-compatible, the provider appends
# /chat/completions only -> NORA_LLM_BASE_URL must INCLUDE /v1 (e.g. Ollama's
# OpenAI-compat surface is http://host.docker.internal:11434/v1). With
# NORA_LLM_PROVIDER=ollama the URL is Ollama-native (no /v1 anywhere).
NORA_LLM_PROVIDER=
NORA_LLM_BASE_URL=http://host.docker.internal:11434
NORA_LLM_MODEL=
NORA_LLM_API_KEY=
NORA_EMBEDDING_PROVIDER=
NORA_EMBEDDING_MODEL=
#NORA_LLM_TIMEOUT=
#NORA_LLM_VERIFY_SSL=
#NORA_LLM_SKIP_PROXY=

# Permanent-refusal fallback for the core LLM lanes (synthesis, /test,
# curation chat, eval judge) — same detection rules as the sira lanes.
# A response starting with a configured marker and carrying no JSON
# payload is retried ONCE on the fallback endpoint. All three of
# markers + base URL + model must be set; base URL follows the
# NORA_LLM_BASE_URL convention (INCLUDES /v1). Markers are ||-separated
# and live only in this local file — never committed.
#NORA_LLM_REFUSAL_MARKERS=
#NORA_LLM_FALLBACK_BASE_URL=http://host.docker.internal:PORT/v1
#NORA_LLM_FALLBACK_MODEL=
#NORA_LLM_FALLBACK_API_KEY=
#NORA_OLLAMA_TIMEOUT_S=

# ---- proprietary-LLM answer hygiene (D-104) -----------------------------------
# Set =1 when the synthesis LLM emits untagged chain-of-thought (the
# ===FINAL_ANSWER=== sentinel strip). Per stack — depends on that stack's LLM.
#NORA_LLM_REASONING_SENTINEL=
#NORA_LLM_DEBUG_RAW=

# ---- SIRA lane (select-synth + pinning) ---------------------------------------
#NORA_SIRA_QUERY_TIMEOUT=
#NORA_SIRA_SYNTH_MODE=
#NORA_SIRA_SYNTH_TOKEN_BUDGET=
#NORA_SIRA_PIN_MODE=balanced
#NORA_SIRA_PIN_MAX=
#NORA_SIRA_PIN_MIN_SCORE=
#NORA_SIRA_PIN_REL_THRESHOLD=

# Enrichment-review Apply fan-out: comma-separated sira-query base URLs to
# reload when the expert clicks Apply. Default = this stack's own service
# only. With BOTH a/b stacks live, list both so one Apply covers them, e.g.
#   NORA_SIRA_QUERY_URLS=http://sira-query:8040,http://host.docker.internal:8041
# (the second stack is reached via the host-published port).
#NORA_SIRA_QUERY_URLS=
