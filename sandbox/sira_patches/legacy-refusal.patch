+    )
+    _lr_fb_url = os.getenv("NORA_SIRA_ENRICH_FALLBACK_LLM_URL", "").rstrip("/")
+    _lr_fb_model = os.getenv("NORA_SIRA_ENRICH_FALLBACK_LLM_MODEL", "")
+
+    async def _lr_fallback(
+        session: aiohttp.ClientSession, doc_text: str
+    ) -> tuple[str, list[str]]:
+        prompt = prompt_template.format(
+            doc_text=doc_text[: enrich_cfg.max_doc_chars], max_n=max_n
+        )
+        payload: dict = {
+            "model": _lr_fb_model or model,
+            "messages": [{"role": "user", "content": prompt}],
+            "max_tokens": enrich_cfg.doc_max_tokens,
+            "temperature": enrich_cfg.temperature,
+        }
+        payload.update(enrich_batching.fallback_reasoning_fields(
+            os.environ, "NORA_SIRA_ENRICH_FALLBACK_LLM_"))
+        data = await post_chat(session, f"{_lr_fb_url}/chat/completions", payload)
+        raw = data["choices"][0]["message"]["content"] or ""
+        return raw, parse_phrases(raw)
+
