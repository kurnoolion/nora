@@ -56,6 +56,21 @@ LLM_STAGES = {"enrich_corpus", "enrich_query", "greprag", "iterative", "rerank"}
 SCRIPTS_DIR = os.path.dirname(os.path.abspath(__file__))
 CONFIGS_DIR = os.path.join(SCRIPTS_DIR, "configs")
 
+# SIRA_EXTRA_CONFIG_DIR: external directory searched FIRST for per-dataset
+# config files (data/<name>.yaml + per-dataset section overrides) so callers
+# can supply generated configs without writing into this source tree.
+EXTRA_CONFIG_DIR = os.environ.get("SIRA_EXTRA_CONFIG_DIR", "")
+
+
+def _cfg_path(*parts: str) -> str:
+    """Resolve a config file: EXTRA_CONFIG_DIR first (if set and present),
+    else the in-tree CONFIGS_DIR."""
+    if EXTRA_CONFIG_DIR:
+        cand = os.path.join(EXTRA_CONFIG_DIR, *parts)
+        if os.path.exists(cand):
+            return cand
+    return os.path.join(CONFIGS_DIR, *parts)
+
 
